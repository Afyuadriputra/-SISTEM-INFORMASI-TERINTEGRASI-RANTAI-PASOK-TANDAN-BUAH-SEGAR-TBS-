# Konfigurasi Lingkungan Demo Lokal (ISOLATED — Hanya untuk agroniaga_demo + Redis /2)
# Salin ke .env.demo (atau jalankan .\scripts\demo-setup.ps1) dan isi password lokal acak.
# JANGAN commit backend/.env.demo ke Git.

APP_NAME=AgroNiaga TBS Supply Chain API (DEMO)
APP_ENV=development
APP_VERSION=1.0.0
APP_DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

DATABASE_URL=postgresql+psycopg://agroniaga_demo:CHANGE_ME_LOCAL_DEMO_PASSWORD@127.0.0.1:15432/agroniaga_demo
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000

REDIS_URL=redis://127.0.0.1:6379/2
REDIS_CONNECT_TIMEOUT_SECONDS=2.0
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
REDIS_MAX_CONNECTIONS=20

SESSION_COOKIE_NAME=ts_agroniaga_demo_session
SESSION_SECRET=REPLACE_WITH_LOCAL_RANDOM_48BYTE_SESSION_SECRET_DO_NOT_USE_IN_PROD
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=28800
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_IP_RATE_LIMIT_MAX_ATTEMPTS=120
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
REQUEST_TIMEOUT_SECONDS=15
FILE_STORAGE_DIR=./var/demo_evidence_files
