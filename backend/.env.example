# AgroNiaga TBS Backend Environment Template (Development / Testing Only)
# Salin ke .env lalu sesuaikan kredensial lokal. Jangan commit berkas .env ke Git.

APP_NAME=AgroNiaga TBS Supply Chain API
APP_ENV=development
APP_VERSION=1.0.0
APP_DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# Database PostgreSQL (Async Psycopg 3)
DATABASE_URL=postgresql+psycopg://agroniaga_dev:change_me_local_only@127.0.0.1:5432/agroniaga_dev
TEST_DATABASE_URL=postgresql+psycopg://agroniaga_dev:change_me_local_only@127.0.0.1:5432/agroniaga_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000

# Redis (Wajib sejak B0; fail-closed pada komponen keamanan)
REDIS_URL=redis://127.0.0.1:6379/0
TEST_REDIS_URL=redis://127.0.0.1:6379/1
REDIS_CONNECT_TIMEOUT_SECONDS=2.0
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
REDIS_MAX_CONNECTIONS=20

# Security & Session Cookie (ADR-005)
# Buat kunci acak unik minimal 32 byte sebelum deployment non-lokal.
SESSION_COOKIE_NAME=ts_agroniaga_session
SESSION_SECRET=local-dev-session-secret-replace-before-staging-32bytes
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=28800
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
REQUEST_TIMEOUT_SECONDS=15
