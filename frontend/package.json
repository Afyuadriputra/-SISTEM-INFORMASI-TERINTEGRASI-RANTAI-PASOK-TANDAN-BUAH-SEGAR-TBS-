{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "codegen:api": "openapi-typescript ../contracts/openapi.v1.yaml -o src/lib/api/generated.d.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/cascadia-mono": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@hookform/resolvers": "^7.0.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.71.0",
    "maplibre-gl": "^6.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^31.0.0",
    "msw": "^3.0.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}